      "parameters": {
        "jsCode": "const toolCall = $input.first().json.body.message.toolCalls[0];\nconst args = toolCall.function['arguments'];\n\nconst startDateTime = new Date(`${args.date}T${args.time}:00`);\nconst endDateTime = new Date(startDateTime.getTime() + 30 * 60000);\nconst pad = n => String(n).padStart(2, '0');\nconst endTime = `${pad(endDateTime.getHours())}:${pad(endDateTime.getMinutes())}`;\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst rawEmail = (args.email || \"\").toString().trim();\nconst validEmail = emailRegex.test(rawEmail) ? rawEmail : null;\n\n// Normalize phone for WATI: full international format, digits only, no '+', no leading 0.\nconst DEFAULT_COUNTRY_CODE = \"92\"; // Pakistan\nlet whatsappNumber = (args.phone_number || \"\").toString().replace(/\\D/g, \"\");\nif (whatsappNumber.startsWith(\"00\")) {\n  // 00 international prefix -> drop it\n  whatsappNumber = whatsappNumber.slice(2);\n} else if (whatsappNumber.startsWith(\"0\")) {\n  // Local format with trunk 0 -> replace with country code\n  whatsappNumber = DEFAULT_COUNTRY_CODE + whatsappNumber.slice(1);\n} else if (!whatsappNumber.startsWith(DEFAULT_COUNTRY_CODE)) {\n  // Bare local number without trunk 0 or country code -> prepend country code\n  whatsappNumber = DEFAULT_COUNTRY_CODE + whatsappNumber;\n}\nconst hasValidPhone = whatsappNumber.length >= 11;\n\nreturn [{\n  json: {\n    toolCallId: toolCall.id,\n    patient_name: args.patient_name,\n    phone_number: args.phone_number,\n    whatsapp_number: whatsappNumber,\n    has_valid_phone: hasValidPhone,\n    service_type: args.service_type,\n    date: args.date,\n    time: args.time,\n    end_time: endTime,\n    email: validEmail,\n    has_valid_email: validEmail !== null\n  }\n}];"
      },
